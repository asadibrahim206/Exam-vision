API_URL=http://127.0.0.1:8000
API_KEY=change-me
SESSION_ID=1

# Real camera (RTSP). URL-encode special characters in the password (@ becomes %40).
# Hikvision: rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
# Dahua:     rtsp://user:pass@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
SOURCE=rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101

MODEL=yolo11m.pt
POSE_MODEL=yolo11s-pose.pt
ENABLE_PHONE=true
ENABLE_HEAD_TURN=true
IMGSZ=960
# DEVICE=0

# Looking at neighbor
HEAD_TURN_RATIO=0.6
HEAD_TURN_SECONDS=3
HEAD_COOLDOWN_SECONDS=30
